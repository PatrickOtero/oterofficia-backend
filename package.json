{
  "name": "oterofficia-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migration:generate": "typeorm-ts-node-commonjs -d src/shared/infra/database/data-source.ts migration:generate src/shared/infra/database/migrations/AutoMigration",
    "migration:run": "typeorm-ts-node-commonjs -d src/shared/infra/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/shared/infra/database/data-source.ts migration:revert",
    "migrate:latest": "npm run migration:run",
    "migrate:rollback": "npm run migration:revert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickOtero/oterofficia-backend.git"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^18.11.3",
    "@types/nodemailer": "^6.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "nodemailer": "^6.8.0",
    "nodemailer-express-handlebars": "^5.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
