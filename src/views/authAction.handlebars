<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>{{ title }}</title>
  </head>
  <body style="font-family: Arial, sans-serif; background: #071019; color: #d5f4ff; margin: 0; padding: 32px;">
    <div
      style="
        max-width: 560px;
        margin: 0 auto;
        padding: 32px;
        border-radius: 24px;
        border: 1px solid rgba(103, 208, 255, 0.2);
        background: linear-gradient(180deg, rgba(14, 26, 39, 0.96), rgba(7, 16, 27, 0.94));
      "
    >
      <p style="font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(213, 244, 255, 0.6);">
        Orbital Archive
      </p>
      <h1 style="margin-top: 0; font-size: 28px; line-height: 1.2;">{{ title }}</h1>
      <p style="font-size: 16px; line-height: 1.7;">{{ intro }}</p>

      <a
        href="{{ actionUrl }}"
        style="
          display: inline-block;
          margin: 12px 0 18px;
          padding: 14px 20px;
          border-radius: 999px;
          border: 1px solid rgba(103, 208, 255, 0.24);
          color: #f7fcff;
          text-decoration: none;
          text-transform: uppercase;
          letter-spacing: 0.1em;
          background: rgba(103, 208, 255, 0.14);
        "
      >
        {{ actionLabel }}
      </a>

      <p style="font-size: 14px; line-height: 1.7; color: rgba(213, 244, 255, 0.72);">
        {{ outro }}
      </p>
    </div>
  </body>
</html>
